{
  "functions": {
    "api.php": { "runtime": "vercel-php@0.7.0" },
    "admin.php": { "runtime": "vercel-php@0.7.0" },
    "index.php": { "runtime": "vercel-php@0.7.0" }
  },
  "routes": [
    { "src": "/admin", "dest": "/admin.php" },
    { "src": "/index", "dest": "/index.php" },
    { "src": "/api", "dest": "/api.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}